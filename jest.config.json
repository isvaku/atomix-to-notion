{
	"preset": "ts-jest",
	"testEnvironment": "node",
	"roots": [
		"<rootDir>/src"
	],
	"testMatch": [
		"**/__tests__/**/*.test.ts"
	],
	"transform": {
		"^.+\\.ts$": "ts-jest"
	},
	"setupFiles": [
		"<rootDir>/jest.setup.js"
	],
	"maxWorkers": 1,
	"testTimeout": 30000,
	"collectCoverageFrom": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts"
	],
	"coverageDirectory": "coverage",
	"coverageReporters": [
		"text",
		"lcov",
		"html"
	]
}
