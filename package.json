{
	"name": "atomix-to-notion",
	"version": "1.5.0",
	"description": "Atomix news crawler that queues articles and syncs them to Notion",
	"main": "dist/index.js",
	"scripts": {
		"build": "rimraf dist && tsc",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"crawler": "tsx src/index.ts --crawler-once",
		"notion-sync": "tsx src/index.ts --notion-sync-once",
		"report": "tsx src/index.ts --report-once",
		"retry-failed": "tsx src/index.ts --retry-failed",
		"setup": "tsx src/scripts/setup.ts",
		"test": "jest",
		"lint": "eslint",
		"clean": "rimraf dist",
		"build-docker-image": "docker build -t isvaku/$npm_package_name:$npm_package_version -t isvaku/$npm_package_name:latest .",
		"push-docker-image": "docker push isvaku/$npm_package_name --all-tags",
		"reimport-notion": "tsx src/scripts/reimport-from-notion.ts",
		"fix-notion-duplicates": "tsx src/scripts/fix-notion-duplicates.ts"
	},
	"keywords": [
		"gaming",
		"news",
		"crawler",
		"notion",
		"mongodb",
		"typescript"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@fastify/rate-limit": "^11.2.0",
		"@notionhq/client": "^5.26.0",
		"bullmq": "^6.3.4",
		"cheerio": "^1.2.0",
		"dayjs": "^1.11.23",
		"dotenv": "^17.4.2",
		"fastify": "^5.12.3",
		"ioredis": "^6.0.0",
		"mongoose": "^8.24.4",
		"node-html-parser": "^9.0.4",
		"puppeteer": "^25.10.0",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^24.13.4",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.10.0",
		"jest": "^30.5.1",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=12.0.0"
	},
	"packageManager": "pnpm@12.4.2"
}
