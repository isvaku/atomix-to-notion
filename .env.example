# Copy to .env and fill in. Docker Compose reads this same file.

# Environment
NODE_ENV=development
# Used for schedules and for the dates shown in the dashboard
TZ=America/Mexico_City

# MongoDB (articles and their sync state)
MONGODB_URI=mongodb://localhost:27017/gaming-news-crawler

# Redis (job queues). In Docker Compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# HTTP API and dashboard
PORT=3000
# Required in production. Generate one with: openssl rand -hex 32
API_KEY=

# Notion (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Daily report of failures (https://t.me/BotFather creates the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_INTERVAL=0 9 * * *
# Send the report even when nothing failed
REPORT_ALWAYS=false

# Notion images
# Copy article images into Notion instead of linking to atomix's CDN, so pages
# keep their images if those URLs ever change. Adds a couple of seconds per
# image to a sync; set to false to keep hotlinking.
NOTION_HOST_IMAGES=true
NOTION_IMAGE_TIMEOUT_MS=30000

# Stored articles
# Warn when the database passes this share of the plan's limit
STORAGE_LIMIT_MB=512
STORAGE_WARN_PERCENT=70
# 0 keeps article HTML forever. A number of days drops it once the article is
# in Notion, which then can only be rewritten by crawling the article again.
CONTENT_RETENTION_DAYS=0

# Alerting
# An external watchdog (e.g. healthchecks.io) pinged after each successful
# discovery. It alerts you when the pings stop - the one failure this app
# can't report itself, because it's the app that's down.
HEALTHCHECK_PING_URL=
# Telegram alert when discovery fails, at most once per this many minutes
DISCOVER_ALERT_COOLDOWN_MINUTES=360

# Schedules
# How often new articles are discovered
CRAWLER_INTERVAL=*/15 * * * *
# Safety net that re-queues entries missing from Notion
NOTION_SYNC_INTERVAL=0 * * * *

# Crawler
MAX_ARTICLES_PER_RUN=100
MAX_PAGES=10
# Attempts per link before a crawl is marked failed
CRAWL_MAX_ATTEMPTS=3
# Attempts per entry before a Notion sync is marked failed
NOTION_SYNC_MAX_ATTEMPTS=5

# Browser (Cloudflare blocks headless mode, so Chromium runs headful)
# Docker sets these; leave them unset locally to use puppeteer's own Chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# CHROME_NO_SANDBOX=true
# CHROME_DISABLE_GPU=true
# Raise it if a slow Raspberry Pi times out starting Chromium
BROWSER_TIMEOUT_MS=180000
# Close Chromium after this long without work
BROWSER_IDLE_CLOSE_MS=120000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
# Docker sets this to false: logs go to stdout only, to spare the SD card
LOG_TO_FILE=true
